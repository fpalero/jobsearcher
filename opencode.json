{
  "$schema": "https://opencode.ai/config.schema.json",
  "mcp": {
    "stitch": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@_davideast/stitch-mcp",
        "proxy"
      ],
      "env": {
        "GOOGLE_CLOUD_PROJECT": "${GOOGLE_CLOUD_PROJECT}",
        "STITCH_API_KEY": "${STITCH_API_KEY}"
      }
    },
    "RapidAPI Hub - JSearch (Mega)": {
      "type": "local",
      "command": [
        "npx",
        "mcp-remote",
        "https://mcp.rapidapi.com",
        "--header",
        "x-api-host: jsearch-mega.p.rapidapi.com",
        "--header",
        "x-api-key: ${RAPID_API_KEY}"
      ]
    },
    "RapidAPI Hub - LinkedIn Jobs": {
      "type": "local",
      "command": [
        "npx",
        "mcp-remote",
        "https://mcp.rapidapi.com",
        "--header",
        "x-api-host: linkedin-jobs12.p.rapidapi.com",
        "--header",
        "x-api-key: ${RAPID_API_KEY}"
      ]
    },
    "RapidAPI Hub - LinkedIn Job Search API": {
      "type": "local",
      "command": [
        "npx",
        "mcp-remote",
        "https://mcp.rapidapi.com",
        "--header",
        "x-api-host: linkedin-job-search-api.p.rapidapi.com",
        "--header",
        "x-api-key: ${RAPID_API_KEY}"
      ]
    }
  }
}